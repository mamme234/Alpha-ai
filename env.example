# AlphaAI environment reference — VARIABLE NAMES ONLY.
#
# Copy the names you need into your own `.env` (never commit it) or paste the
# values into your host's environment settings. Every value here is empty on
# purpose: this file is documentation, not configuration, and must never contain
# a real key, password or connection string.
#
# (The file is named `env.example` rather than `.env.example` because the
# workspace tooling in this repository refuses to write `.env*` paths at all.
# `cp env.example .env` and fill it in.)
#
# AlphaAI performs local inference only. There are no AI provider variables here
# (no OpenAI, Anthropic, Gemini, or Ollama) and none exist anywhere in the code.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
ALPHAI_ROOT=
ALPHAI_CONFIG=
ALPHAI_LOG_LEVEL=
ALPHAI_HOST=
ALPHAI_PORT=
ALPHAI_CORS_ORIGINS=
ALPHAI_MAX_REQUEST_BYTES=
ALPHAI_REDACT_PATHS=

# ---------------------------------------------------------------------------
# Runtime / models (the inference host)
# ---------------------------------------------------------------------------
ALPHAI_DEVICE=
ALPHAI_DTYPE=
ALPHAI_CPU_THREADS=
ALPHAI_GPU_LAYERS=
ALPHAI_MODELS_DIR=
ALPHAI_STATE_DIR=
ALPHAI_WORKSPACE_DIR=
ALPHAI_LOG_DIR=
ALPHAI_ALLOW_MODEL_DOWNLOAD=
ALPHAI_TEMPERATURE=
ALPHAI_TOP_P=
ALPHAI_MAX_TOKENS=
ALPHAI_ENGINES=
ALPHAI_SKILLS=
ALPHAI_TOOLS=
ALPHAI_TOOL_NETWORK=
ALPHAI_TOOL_CODE_EXEC=
ALPHAI_TOOL_WRITES=

# ---------------------------------------------------------------------------
# Remote inference (Vercel gateway -> the always-on inference host)
# ---------------------------------------------------------------------------
# Base URL of an `alphaai serve` instance. Setting it makes THIS deployment a
# stateless gateway that forwards /api/* instead of loading a model.
ALPHAI_INFERENCE_URL=
# Alias accepted as well: ALPHA_INFERENCE_URL.
# AlphaAI-to-AlphaAI shared secret (never an AI provider key). The gateway sends
# it as `Authorization: Bearer`; an inference host that sets it requires it on
# /api/*. Leave it unset on a host that also serves the browser dashboard.
ALPHAI_INFERENCE_TOKEN=
# Alias accepted as well: ALPHA_INFERENCE_TOKEN.
ALPHAI_INFERENCE_TIMEOUT_S=

# ---------------------------------------------------------------------------
# Database — conversation history (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------
# The single connection string AlphaAI needs, and the only database credential
# it uses. Server-side only: it is never sent to a browser, and no Supabase
# *API* key is required anywhere (no anon key, no service-role key).
#
# Pick the connection method that matches the deployment:
#   long-lived host (the AlphaAI inference container) -> direct 5432, or Supavisor session mode
#   serverless / short-lived (the Vercel gateway)     -> Supavisor transaction mode (port 6543)
# They are not interchangeable. See docs/DATABASE.md.
#
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Expected shape (placeholders, not values):
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=
# Optional: a connection string for this process which wins over DATABASE_URL.
ALPHAI_DATABASE_URL=
ALPHAI_DB_SSL_MODE=
ALPHAI_DB_CONNECT_TIMEOUT_S=
ALPHAI_DB_STATEMENT_TIMEOUT_MS=
ALPHAI_DB_APPLICATION_NAME=
ALPHAI_DB_MAX_LIST_LIMIT=
# Apply pending SQL migrations during API startup (opt-in).
ALPHAI_DB_MIGRATE_ON_START=
ALPHAI_MIGRATIONS_DIR=

# ---------------------------------------------------------------------------
# Tests (developer machines and CI only)
# ---------------------------------------------------------------------------
# Point the persistence tests at any empty PostgreSQL database. Without it they
# are skipped, unless `pgserver` is installed (then a temporary server is used
# automatically).
ALPHAI_TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Hosting (set by the platform, listed so a deployment can be checked)
# ---------------------------------------------------------------------------
# Vercel: VERCEL, VERCEL_ENV, VERCEL_URL
# Render: RENDER, RENDER_SERVICE_NAME, PORT (AlphaAI binds $PORT when provided)
